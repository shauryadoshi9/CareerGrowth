# CareerGrowth Server Environment Configuration (Placeholders)
# Copy this file to .env and configure your secrets

PORT=5000

# Minimum 32 characters required for secure JWT signing
JWT_SECRET=replace_with_a_secure_random_32_character_secret_here

# Optional: Google Gemini API Key for dynamic AI tutoring and lesson generation
# Leave blank to use the built-in smart algorithmic fallback tutor engine
GEMINI_API_KEY=

# Comma-separated list of allowed frontend origins for CORS
ALLOWED_ORIGIN=http://localhost:3000,http://localhost:3001

# Set to true for hackathon demo mode (enables instant demo account login)
DEMO_MODE=true
